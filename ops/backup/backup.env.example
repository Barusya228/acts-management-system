# Must match PDF_BACKUP_HOST_PATH used by docker-compose.yml.
PROJECT_ROOT=/home/ruslan_adm/acts-management-system
COMPOSE_PROJECT_NAME=acts_v3
PDF_BACKUP_HOST_PATH=/home/ruslan_adm/acts-management-system/backend/pdf-backups

# Use an rclone crypt remote, not the unencrypted Google Drive remote.
RCLONE_REMOTE=gdrive-crypt:acts-management-system-backups

# Local copies are short-lived; Google Drive keeps longer recovery history.
LOCAL_RETENTION_DAYS=7
REMOTE_RETENTION_DAYS=90

# "download" verifies remote content by downloading it. "size" is faster but weaker.
RCLONE_CHECK_MODE=download
